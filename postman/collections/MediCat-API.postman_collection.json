{
  "info": {
    "name": "MediCat API",
    "description": "Colección completa para probar la API de MediCat con JWT. Ejecutar primero 'Auth / Login' para poblar {{token}}. Cubre todos los verbos (GET/POST/PUT/PATCH/DELETE) declarados en los controllers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 401) {",
          "  console.warn('401: token ausente o expirado. Re-ejecuta Auth / Login.');",
          "} else if (pm.response.code === 403) {",
          "  console.warn('403: el rol ' + pm.environment.get('rol') + ' no tiene acceso a este endpoint.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (guarda token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasenia\": \"{{contrasenia}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('respuesta trae token', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('token', data.token);",
                  "pm.environment.set('rol', data.rol);",
                  "pm.environment.set('userId', data.id);",
                  "console.log('Logueado como', data.correo, '(' + data.rol + ') id=' + data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/forgot-password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin1@vet.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] }
          }
        },
        {
          "name": "POST /api/auth/reset-password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<TOKEN-DEL-EMAIL>\",\n  \"contrasenia\": \"nueva123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] }
          }
        }
      ]
    },
